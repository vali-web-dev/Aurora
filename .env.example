# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/aurora

# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# API Keys
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-secret

# Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@aurora.app

# File Storage
AWS_S3_ACCESS_KEY_ID=your-aws-key
AWS_S3_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET_NAME=aurora-storage
AWS_S3_REGION=us-east-1

# Monitoring & Logging
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info

# Feature Flags
ENABLE_REAL_TIME=true
ENABLE_PAYMENTS=false
ENABLE_AI_FEATURES=false
