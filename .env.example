# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/aurora
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:5432/aurora

# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

# Payment Provider Selection (stripe or adyen)
PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLIC_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-secret

# Adyen Configuration (optional)
ADYEN_API_KEY=your_adyen_api_key_here
ADYEN_MERCHANT_ACCOUNT=your_merchant_account_here
ADYEN_CLIENT_KEY=your_client_key_here

# ============================================================================
# FULFILLMENT & TRACKING
# ============================================================================

# Carrier APIs
FEDEX_API_KEY=your_fedex_api_key
FEDEX_ACCOUNT_NUM=your_fedex_account_number
UPS_API_KEY=your_ups_api_key
UPS_ACCOUNT_NUM=your_ups_account_number
DHL_API_KEY=your_dhl_api_key

# ============================================================================
# INVOICE GENERATION
# ============================================================================
INVOICE_PDF_ENABLED=true
INVOICE_EMAIL_ENABLED=true
INVOICE_STORAGE_PATH=./invoices

# Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@aurora.app

# File Storage
AWS_S3_ACCESS_KEY_ID=your-aws-key
AWS_S3_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET_NAME=aurora-storage
AWS_S3_REGION=us-east-1

# ============================================================================
# EVENT TRACKING & ANALYTICS
# ============================================================================
EVENT_TRACKING_ENABLED=true
ANALYTICS_API_URL=http://localhost:3000/api/analytics
ANALYTICS_BATCH_SIZE=10
ANALYTICS_FLUSH_INTERVAL_MS=5000

# ============================================================================
# DIAGNOSTICS & MONITORING
# ============================================================================
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
ENABLE_DIAGNOSTICS=true
AURORA_STABLE_URL=http://localhost:3000
AURORA_CANARY_URL=http://localhost:3001
SCHEDULE_WEBHOOK_URL=http://your-webhook-service/webhooks/diagnostics

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_REAL_TIME=true
ENABLE_PAYMENTS=true
ENABLE_AI_FEATURES=false

