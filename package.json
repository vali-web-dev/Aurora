{
	"name": "aurora-rv0",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "cross-env NEXT_DIST_DIR=.next-dev next dev",
		"clean:next": "node -e \"const fs=require('fs');for(const d of ['.next','.next-dev','.next-build']){try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}}\"",
		"dev:server": "tsx server.js",
		"build": "npm run clean:next && cross-env NEXT_DIST_DIR=.next-build NEXT_IGNORE_INCORRECT_LOCKFILE=1 node scripts/next-build-retry.js",
		"build:raw": "cross-env NEXT_DIST_DIR=.next-build NEXT_IGNORE_INCORRECT_LOCKFILE=1 node scripts/next-build-retry.js",
		"build:ci": "npm run clean:next && npm run lint:strict && cross-env NEXT_DIST_DIR=.next-build NEXT_IGNORE_INCORRECT_LOCKFILE=1 node scripts/next-build-retry.js",
		"start": "cross-env NEXT_DIST_DIR=.next-build next start",
		"start:server": "node server.js",
		"lint": "next lint",
		"lint:strict": "next lint --max-warnings 0",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:drop": "drizzle-kit drop",
		"db:seed": "node --import tsx src/lib/seed.ts",
		"db:format": "drizzle-kit up",
		"logos:routes:export": "node --import tsx scripts/export-logo-routes-v1.ts",
		"logos:routes:export:a": "node --import tsx scripts/export-logo-routes-v1.ts --route a",
		"logos:routes:export:b": "node --import tsx scripts/export-logo-routes-v1.ts --route b",
		"logos:routes:export:c": "node --import tsx scripts/export-logo-routes-v1.ts --route c",
		"logos:routes:preview": "node --import tsx scripts/export-logo-routes-preview-v1.ts"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.1",
		"autoprefixer": "^10.4.20",
		"bcryptjs": "^3.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.3.1",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"next": "^14.2.35",
		"next-auth": "^5.0.0-beta.30",
		"postcss": "^8.4.47",
		"postgres": "^3.4.8",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-markdown": "^10.1.0",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"tailwindcss": "^3.4.10",
		"typescript": "^5.6.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.3.0",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.1",
		"@types/socket.io": "^3.0.2",
		"cross-env": "^7.0.3",
		"eslint": "^8.57.0",
		"eslint-config-next": "14.2.35",
		"sharp": "^0.34.5",
		"tsx": "^4.21.0"
	}
}
